# Digital Docent — 환경 계약 (contract only, no values)
#
# 이 파일은 "어떤 변수가 있어야 하는가" 만 적는다. 실제 값은 여기에 절대 쓰지
# 않는다. 로컬 값은 .env.local 에, 배포 값은 호스팅 대시보드의 환경변수에 둔다.
# .env.local 은 .gitignore 에 걸려 있고, 이 파일은 값이 없으므로 추적해도 된다.
#
#   cp .env.example .env.local   # 그 다음 로컬 경로를 채운다


# ─────────────────────────────────────────────────────────────────────────────
# 음성 백엔드 선택
# ─────────────────────────────────────────────────────────────────────────────
# local  : 이 기계에 상주하는 파이썬 워커 (개발 기본값)
# runpod : RunPod Serverless Flex 엔드포인트 (프로덕션)
#
# 값이 없으면 local 로 본다. 브라우저 TTS 폴백은 이것과 무관하게 항상 남아 있다.
DOCENT_VOICE_BACKEND=local


# ─────────────────────────────────────────────────────────────────────────────
# DOCENT_VOICE_BACKEND=local 일 때만 필요
# ─────────────────────────────────────────────────────────────────────────────
# 두 모델은 한 인터프리터에 공존할 수 없다 — Supertonic 은 onnxruntime + numpy 2.x,
# LAM 은 torch 2.1.2+cu121 + numpy 1.26. 그래서 venv 도 둘이다.
#
# 다섯 개가 모두 있어야 로컬 백엔드가 뜬다. 하나라도 비면 /api/docent/voice 는
# 503 "voice backend not configured" 를 주고 클라이언트는 브라우저 TTS 로 내려간다.
DD_SUPERTONIC_PYTHON=
DD_SUPERTONIC_MODEL_DIR=
DD_LAM_PYTHON=
DD_LAM_SRC=
DD_LAM_CKPT=

# 합성 산출물이 잠시 머무는 디렉터리. 비우면 OS 임시 디렉터리 아래를 쓴다.
# 발화가 끝나면 그 파일은 지운다.
DD_VOICE_WORK_DIR=


# ─────────────────────────────────────────────────────────────────────────────
# DOCENT_VOICE_BACKEND=runpod 일 때만 필요
# ─────────────────────────────────────────────────────────────────────────────
# 엔드포인트 ID 는 배포마다 다르므로 소스에 박지 않는다.
RUNPOD_ENDPOINT_ID=

# ⚠ 서버 전용. 브라우저로 절대 내려가면 안 된다.
#   - NEXT_PUBLIC_ 접두사를 붙이지 말 것 (붙는 순간 번들에 들어간다)
#   - 응답 본문·로그·스크린샷·문서 어디에도 값을 남기지 말 것
#   - 실제 값은 이 파일이 아니라 호스팅 대시보드의 암호화된 환경변수에 넣을 것
RUNPOD_API_KEY=

# RunPod 왕복 상한(ms). 비우면 180000.
# 콜드 워커는 컨테이너 기동 + 모델 로드를 포함하므로 웜 요청보다 훨씬 길다.
RUNPOD_TIMEOUT_MS=


# ─────────────────────────────────────────────────────────────────────────────
# 대화 (음성과 무관)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠ 서버 전용. 키가 하나도 없으면 /api/docent/chat 은 LLM 없이 검색 근거를 발췌해 답한다(evidence 모드).
# 있으면 검색 근거 + 페이지 문맥을 시스템 프롬프트에 싣고 LLM 이 답을 생성한다(live 모드).
# 선택 순서: OPENAI_API_KEY → ANTHROPIC_API_KEY. DD 답변은 GPT 로 한다(Human 결정, 2026-09-22).
# 이 키는 유료 계정의 자격증명이다 — 만드는 것은 Human 의 결정이다. 값은 호스팅 대시보드에만.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 도슨트가 쓰는 모델. 비우면 OpenAI 는 gpt-5.6-luna, Anthropic 은 claude-haiku-4-5.
# 더 좋게: gpt-5.6-terra, gpt-5.6 (= gpt-5.6-sol).
# 다른 프로바이더용 이름(예: OpenAI 에 claude-*)을 넣으면 무시하고 기본값을 쓴다.
DOCENT_MODEL=

# OpenAI reasoning effort: none | minimal | low | medium | high | xhigh | max. 비우면 medium.
DOCENT_REASONING_EFFORT=


# ─────────────────────────────────────────────────────────────────────────────
# 공개 자산 URL — NEXT_PUBLIC_ 은 브라우저 번들에 들어간다
# ─────────────────────────────────────────────────────────────────────────────
# 이 접두사는 "공개해도 되는 값" 이라는 선언이다. 비밀에는 절대 붙이지 않는다.
NEXT_PUBLIC_ARMI_FULL_VIDEO=
NEXT_PUBLIC_HANGARAE_FULL_VIDEO=
